{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["title", "subtitle", "version", "updated", "content", "sections"],
  "properties": {
    "title": {"type":"string", "minLength":1}, "subtitle": {"type":"string", "minLength":1},
    "eyebrow": {"type":"string"}, "version": {"type":"string"},
    "updated": {"type":"string", "pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "language": {"enum":["pt-BR", "en"]},
    "theme": {"enum":["default", "santander"]},
    "mode": {"enum":["full", "summary"]},
    "companionDoc": {"type":"object", "additionalProperties":false, "required":["href","label"], "properties":{"href":{"type":"string","minLength":1},"label":{"type":"string","minLength":1}}},
    "content": {"type":"string"}, "repoRoot": {"type":"string"}, "revision": {"type":"string"},
    "dataAsOf": {"type":"string"},
    "cards": {"type":"array", "maxItems":4, "items":{"type":"object", "additionalProperties":false, "required":["label","value","description"], "properties":{"label":{"type":"string"},"value":{"type":"string"},"description":{"type":"string"}}}},
    "sections": {"type":"array", "minItems":1, "items":{"type":"object", "additionalProperties":false, "required":["id","title","audience"], "properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},"title":{"type":"string"},"audience":{"enum":["all","business","technical","operations"]},"sources":{"type":"array","items":{"type":"string"}}}}},
    "sources": {"type":"array", "items":{"type":"object", "additionalProperties":false, "required":["id","path","description"], "properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},"path":{"type":"string"},"description":{"type":"string"}}}}
  }
}
